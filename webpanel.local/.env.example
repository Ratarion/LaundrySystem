# Настройки локальной базы данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=layndaru_db
DB_USER=postgres
DB_PASS=postgres
DB_SSLMODE=disable

# Токены ботов для отправки уведомлений жильцам из веб-панели
# 1. Telegram Bot Token (тот же, что и у tgbot)
TG_BOT_TOKEN=your_telegram_bot_token_here

# 2. ВКонтакте (токен сообщества с правами на сообщения)
VK_TOKEN=your_vk_group_token_here
VK_GROUP_ID=your_vk_group_id_here

# 3. MAX Messenger (токен бота от @MasterBot)
MAX_TOKEN=your_max_bot_token_here
