# ==========================================
# Настройки базы данных PostgreSQL (Сервер в РФ)
# ==========================================
DB_NAME=layndaru_db
DB_USER=postgres
# Обязательно смените пароль на надежный при выкатке на боевой сервер!
DB_PASS=ChangeMe_StrongPassword123!

# ==========================================
# Токены ботов для веб-панели и сервисов
# ==========================================
# 1. Telegram Bot Token (для уведомлений из веб-панели)
TG_BOT_TOKEN=

# 2. ВКонтакте (для vkbot и уведомлений из веб-панели)
VK_TOKEN=
VK_GROUP_ID=

# 3. MAX Messenger (для maxbot и уведомлений из веб-панели)
MAX_TOKEN=
