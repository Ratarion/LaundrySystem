# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Настройки подключения к локальной БД PostgreSQL
HOST=localhost
PORT=5432
USER=postgres
PASSWORD=postgres
DBNAME=layndaru_db

# Полный URL для asyncpg (используется SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/layndaru_db
