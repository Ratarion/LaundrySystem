# Токен бота MAX (получается у @MasterBot в мессенджере MAX - max.ru/masterbot)
MAX_TOKEN=your_max_bot_token_here

# Подключение к локальной базе данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/layndaru_db

# Или раздельные параметры подключения
DB_HOST=localhost
DB_PORT=5432
DB_NAME=layndaru_db
DB_USER=postgres
DB_PASS=postgres
